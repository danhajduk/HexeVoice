{
  "schema_version": 1,
  "screens": [
    {
      "id": "updating",
      "conditions": { "match": "all", "items": [{ "flag": "ota_active" }] },
      "elements": [
        { "type": "clock" },
        {
          "type": "progress_bar",
          "x": 312,
          "y": 520,
          "width": 400,
          "height": 18,
          "color": "#35F4DB",
          "track_color": "#102E4A"
        }
      ]
    },
    {
      "id": "updating_phase",
      "conditions": { "match": "all", "items": [{ "flag": "updating" }] },
      "elements": [
        { "type": "clock" },
        {
          "type": "progress_bar",
          "x": 312,
          "y": 520,
          "width": 400,
          "height": 18,
          "color": "#35F4DB",
          "track_color": "#102E4A"
        }
      ]
    },
    {
      "id": "listening",
      "conditions": { "match": "all", "items": [{ "flag": "listening" }] },
      "elements": [
        { "type": "clock" },
        { "type": "activity", "sprite": "listening" }
      ]
    },
    {
      "id": "thinking",
      "conditions": { "match": "all", "items": [{ "flag": "thinking" }] },
      "elements": [
        { "type": "clock" },
        { "type": "activity", "sprite": "thinking" }
      ]
    },
    {
      "id": "playback",
      "conditions": { "match": "all", "items": [{ "flag": "playback_active" }] },
      "elements": [
        { "type": "clock" },
        { "type": "activity", "sprite": "replay" }
      ]
    },
    {
      "id": "replying",
      "conditions": { "match": "all", "items": [{ "flag": "replying" }] },
      "elements": [
        { "type": "clock" },
        { "type": "activity", "sprite": "replay" }
      ]
    },
    {
      "id": "timer_finished",
      "conditions": { "match": "all", "items": [{ "flag": "timer_finished" }] },
      "elements": [
        { "type": "clock" },
        { "type": "activity", "sprite": "timer" }
      ]
    },
    {
      "id": "timer",
      "conditions": {
        "match": "all",
        "items": [
          { "flag": "timer_active" },
          { "flag": "idle_ready" }
        ]
      },
      "elements": [
        { "type": "idle_clock" },
        { "type": "activity", "sprite": "timer" },
        { "type": "timer" }
      ]
    },
    {
      "id": "idle",
      "conditions": { "match": "all", "items": [{ "flag": "idle_ready" }] },
      "elements": [
        { "type": "idle_clock" }
      ]
    },
    {
      "id": "muted",
      "conditions": { "match": "all", "items": [{ "flag": "muted" }] },
      "elements": [
        { "type": "clock" }
      ]
    },
    {
      "id": "error",
      "conditions": { "match": "all", "items": [{ "flag": "error" }] },
      "elements": [
        { "type": "clock" }
      ]
    },
    {
      "id": "backend_connecting",
      "conditions": { "match": "all", "items": [{ "flag": "backend_connecting" }] },
      "elements": [
        { "type": "clock" }
      ]
    },
    {
      "id": "wifi_connecting",
      "conditions": { "match": "all", "items": [{ "flag": "wifi_connecting" }] },
      "elements": [
        { "type": "clock" }
      ]
    },
    {
      "id": "booting",
      "conditions": { "match": "all", "items": [{ "flag": "booting" }] },
      "elements": [
        { "type": "clock" }
      ]
    },
    {
      "id": "default",
      "elements": [
        { "type": "clock" }
      ]
    }
  ]
