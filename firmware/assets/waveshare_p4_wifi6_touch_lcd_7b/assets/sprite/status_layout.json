    "right": {
      "type": "slide_in",
      "when": {"flag": "ui_ready", "equals": true},
      "offset": {"x": 1.0, "y": 0.0},
      "period_ms": 1000
    }
  },
  "sidebar_buttons": {
    "enabled": true,
    "x": 16,
    "y": 116,
    "gap": 20
