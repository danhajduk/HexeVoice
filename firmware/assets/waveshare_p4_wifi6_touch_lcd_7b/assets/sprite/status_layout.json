    {"id": "mic_enabled", "placement": "floating"},
    {"id": "mic_disabled", "placement": "floating"},
    {"id": "mic_active", "placement": "floating"},
    {"id": "dnd", "placement": "floating"},
    {"id": "mute", "placement": "floating"},
    {"id": "timer", "placement": "floating"},
    {"id": "alarm", "placement": "floating"},
    {"id": "playback", "placement": "floating"},
    {"id": "update_available", "placement": "floating"},
    {"id": "warning", "placement": "floating"},
    {"id": "privacy", "placement": "floating"},
    {"id": "cloud_offline", "placement": "floating"}
    ]
