        {
          "type": "slide_in",
          "when": {"flag": "idle_ready", "equals": true},
          "offset": {"x": -0.2, "y": 0.0},
          "period_ms": 550
        }
      ]
    },
    "separator": {
      "font": "manrope/clock_42.hxf",
      "font_size": 98,
      "x": 512,
      "y": 232,
      "color": "#35F4DB",
      "animations": [
        {
          "type": "pulse",
          "when": {"flag": "idle_ready", "equals": true},
          "period_ms": 2000,
          "min_opacity": 90,
          "max_opacity": 255
        }
      ]
    },
    "minutes": {
      "font": "manrope/clock_42.hxf",
      "font_size": 118,
      "x": 609,
