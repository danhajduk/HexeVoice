      "color": "#D8FFFA",
      "animations": [
        {
          "type": "slide_in",
          "when": {"flag": "idle_ready", "equals": true},
          "offset": {"x": 0.2, "y": 0.0},
          "period_ms": 550
        }
      ]
    },
    "date": {
      "font": "manrope/date_32.hxf",
      "font_size": 40,
      "y": 15,
      "color": "#55B8FF",
      "animations": [
        {
          "type": "slide_in",
          "when": {"flag": "idle_ready", "equals": true},
          "offset": {"x": 0.0, "y": 0.4},
          "period_ms": 650
        }
      ]
