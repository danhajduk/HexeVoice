      "x": 760,
      "y": 430,
      "gap": 38,
      "count": 3,
      "color": "#55B8FF"
    }
  },
  "sidebars": {
    "left": {
      "type": "slide_in",
      "when": {"flag": "ui_ready", "equals": true},
      "offset": {"x": -1.0, "y": 0.0},
      "period_ms": 1000
