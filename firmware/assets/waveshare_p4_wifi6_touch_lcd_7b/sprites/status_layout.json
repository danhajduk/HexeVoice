{
  "schema_version": 1,
  "idle_clock": {
    "enabled": true,
    "date_format": "%a, %b %d",
    "sprite": {
      "x": 262,
      "y": 205,
      "animations": [
        {
          "type": "slide_in",
          "when": {"flag": "idle_ready", "equals": true},
          "offset": {"x": 0.0, "y": 0.15},
          "period_ms": 500
        }
      ]
    },
    "hours": {
      "font": "manrope/clock_42.hxf",
      "font_size": 118,
      "x": 415,
      "y": 240,
      "color": "#D8FFFA",
      "animations": [
        {
          "type": "slide_in",
          "when": {"flag": "idle_ready", "equals": true},
          "offset": {"x": -0.2, "y": 0.0},
          "period_ms": 550
        }
      ]
    },
    "separator": {
      "font": "manrope/clock_42.hxf",
      "font_size": 98,
      "x": 512,
      "y": 247,
      "color": "#35F4DB",
      "animations": [
        {
          "type": "pulse",
          "when": {"flag": "idle_ready", "equals": true},
          "period_ms": 1000,
          "min_opacity": 90,
          "max_opacity": 255
        }
      ]
    },
    "minutes": {
      "font": "manrope/clock_42.hxf",
      "font_size": 118,
      "x": 609,
      "y": 240,
      "color": "#D8FFFA",
      "animations": [
        {
          "type": "slide_in",
          "when": {"flag": "idle_ready", "equals": true},
          "offset": {"x": 0.2, "y": 0.0},
          "period_ms": 550
        }
      ]
    },
    "date": {
      "font": "manrope/date_32.hxf",
      "font_size": 30,
      "x": 512,
      "y": 370,
      "color": "#55B8FF",
      "animations": [
        {
          "type": "slide_in",
          "when": {"flag": "idle_ready", "equals": true},
          "offset": {"x": 0.0, "y": 0.4},
          "period_ms": 650
        }
      ]
    }
  },
  "sidebars": {
    "left": {
      "type": "slide_in",
      "when": {"flag": "ui_ready", "equals": true},
      "offset": {"x": -1.0, "y": 0.0},
      "period_ms": 1500
    },
    "right": {
      "type": "slide_in",
      "when": {"flag": "ui_ready", "equals": true},
      "offset": {"x": 1.0, "y": 0.0},
      "period_ms": 1500
    }
  },
  "clock": {
    "font": "manrope/clock_42.hxf",
    "font_size": 55,
    "color": "#35F4DB",
    "x_offset": 0,
    "y_offset": 15
  },
  "version": {
    "font": "manrope/version_24.hxf",
    "font_size": 20,
    "color": "#55B8FF",
    "x": 480,
    "y": 550
  },
  "y": 10,
  "floating": {
    "x": 30,
    "gap": 0
  },
  "icons": [
    {
      "id": "wifi",
      "placement": "static",
      "x": 900,
      "animations": [
        {
          "type": "blink_dot",
          "when": {"flag": "wifi_connecting", "equals": true},
          "color": "#35F4DB",
          "position": {"x": 0.5, "y": 0.8},
          "radius": 0.08,
          "period_ms": 800
        }
      ]
    },
    {
      "id": "node_connected",
      "placement": "static",
      "x": 960,
      "animations": [
        {
          "type": "pulse",
          "when": {"flag": "heartbeat", "equals": true},
          "period_ms": 1800,
          "min_opacity": 150,
          "max_opacity": 255
        },
        {
          "type": "pulse_ring",
          "when": {"flag": "backend_connecting", "equals": true},
          "color": "#55B8FF",
          "position": {"x": 0.5, "y": 0.5},
          "radius": 0.28,
          "period_ms": 1200
        }
      ]
    },
    {
      "id": "asset_downloading",
      "placement": "floating",
      "animations": [
        {
          "type": "running_dots",
          "when": {"flag": "asset_sync_active", "equals": true},
          "color": "#35F4DB",
          "position": {"x": 0.5, "y": 0.1},
          "count": 3,
          "radius": 0.055,
          "spacing": 0.2,
          "period_ms": 900
        }
      ]
    }
  ]
}
