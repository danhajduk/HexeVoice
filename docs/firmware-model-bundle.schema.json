{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexe.local/schemas/firmware-model-bundle.schema.json",
  "title": "Hexe Firmware Model Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_api_version",
    "bundle_id",
    "version",
    "created_at_utc",
    "release_channel",
    "security_policy",
    "compatibility",
    "preprocessing",
    "models",
    "hashes",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "hexe-model-bundle-v1" },
    "model_api_version": { "const": "hexe-model-bundle-api-v1" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "release_channel": { "type": "string", "minLength": 1 },
    "security_policy": { "const": "signed_manifest_sha256_required" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firmware_api_version",
        "board_profiles",
        "partition_schemas",
        "requires_partitions",
        "minimum_model_bank_bytes"
      ],
      "properties": {
        "firmware_api_version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "string", "minLength": 1 },
            "max": { "type": "string", "minLength": 1 }
          }
        },
        "board_profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "partition_schemas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "requires_partitions": {
          "type": "array",
          "contains": { "const": "model_a" },
          "items": { "type": "string", "minLength": 1 }
        },
        "minimum_model_bank_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sample_rate_hz", "feature_step_size_ms", "asset"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sample_rate_hz": { "type": "integer", "minimum": 1 },
        "feature_step_size_ms": { "type": "integer", "minimum": 1 },
        "asset": { "$ref": "#/$defs/asset" }
      }
    },
    "models": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/model" }
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "scope", "value"],
      "properties": {
        "algorithm": { "const": "hmac-sha256" },
        "key_id": { "type": "string", "minLength": 1 },
        "scope": { "const": "canonical_manifest_without_signature" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "wake_word",
        "source",
        "author",
        "trained_languages",
        "upstream_version",
        "minimum_esphome_version",
        "metadata",
        "model",
        "thresholds"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["wake", "playback_stop"] },
        "wake_word": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "trained_languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "upstream_version": { "type": "integer" },
        "minimum_esphome_version": { "type": "string" },
        "metadata": { "$ref": "#/$defs/asset" },
        "model": { "$ref": "#/$defs/asset" },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probability_cutoff",
            "sliding_window_size",
            "feature_step_size_ms",
            "tensor_arena_size"
          ],
          "properties": {
            "probability_cutoff": { "type": "number", "minimum": 0, "maximum": 1 },
            "sliding_window_size": { "type": "integer", "minimum": 1 },
            "feature_step_size_ms": { "type": "integer", "minimum": 1 },
            "tensor_arena_size": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
