{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexe.local/docs/events-schemsa/timer-request-event.schema.json",
  "title": "HexeVoice Published Timer Request Event",
  "description": "MQTT domain events HexeVoice publishes after local timer voice intents.",
  "type": "object",
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "source", "subject", "data"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "$ref": "timer-common.schema.json#/$defs/event_id"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "timer.create_requested",
        "timer.status_requested",
        "timer.stop_requested",
        "timer.cancel_requested",
        "timer.adjust_time_requested",
        "timer.snooze_requested"
      ]
    },
    "occurred_at": {
      "$ref": "timer-common.schema.json#/$defs/timestamp"
    },
    "source": {
      "$ref": "timer-common.schema.json#/$defs/source"
    },
    "subject": {
      "$ref": "timer-common.schema.json#/$defs/subject"
    },
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/create_request_data"
        },
        {
          "$ref": "#/$defs/status_request_data"
        },
        {
          "$ref": "#/$defs/control_request_data"
        },
        {
          "$ref": "#/$defs/adjust_request_data"
        },
        {
          "$ref": "#/$defs/snooze_request_data"
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "error"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high"]
    },
    "safety_critical": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "base_request_data": {
      "type": "object",
      "required": ["intent", "endpoint_id", "session_id", "heard_text", "requested_at"],
      "properties": {
        "intent": {
          "type": "string"
        },
        "endpoint_id": {
          "$ref": "timer-common.schema.json#/$defs/endpoint_id"
        },
        "session_id": {
          "$ref": "timer-common.schema.json#/$defs/session_id"
        },
        "timer_id": {
          "type": ["string", "null"]
        },
        "scope": {
          "$ref": "timer-common.schema.json#/$defs/timer_scope"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "heard_text": {
          "type": "string"
        },
        "requested_at": {
          "$ref": "timer-common.schema.json#/$defs/timestamp"
        },
        "mqtt_sent_at": {
          "$ref": "timer-common.schema.json#/$defs/timestamp"
        },
        "request_to_mqtt_latency_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "create_request_data": {
      "allOf": [
        {
          "$ref": "#/$defs/base_request_data"
        },
        {
          "type": "object",
          "required": ["duration_seconds", "duration_hhmmss", "duration_text"],
          "properties": {
            "intent": {
              "const": "timer.create"
            },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "duration_hhmmss": {
              "type": "string",
              "pattern": "^[0-9]{2,}:[0-9]{2}:[0-9]{2}$"
            },
            "duration_text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "status_request_data": {
      "allOf": [
        {
          "$ref": "#/$defs/base_request_data"
        },
        {
          "type": "object",
          "required": ["correlation_id"],
          "properties": {
            "intent": {
              "const": "timer.status"
            }
          }
        }
      ]
    },
    "control_request_data": {
      "allOf": [
        {
          "$ref": "#/$defs/base_request_data"
        },
        {
          "type": "object",
          "required": ["action", "correlation_id"],
          "properties": {
            "intent": {
              "type": "string",
              "enum": ["timer.stop", "timer.cancel"]
            },
            "action": {
              "type": "string",
              "enum": ["stop", "cancel"]
            }
          }
        }
      ]
    },
    "adjust_request_data": {
      "allOf": [
        {
          "$ref": "#/$defs/base_request_data"
        },
        {
          "type": "object",
          "required": ["delta_seconds", "delta_hhmmss", "delta_text", "direction", "correlation_id"],
          "properties": {
            "intent": {
              "const": "timer.adjust_time"
            },
            "delta_seconds": {
              "type": "integer",
              "not": {
                "const": 0
              }
            },
            "delta_hhmmss": {
              "type": "string",
              "pattern": "^[0-9]{2,}:[0-9]{2}:[0-9]{2}$"
            },
            "delta_text": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "type": "string",
              "enum": ["add", "remove"]
            }
          }
        }
      ]
    },
    "snooze_request_data": {
      "allOf": [
        {
          "$ref": "#/$defs/base_request_data"
        },
        {
          "type": "object",
          "required": ["duration_seconds", "duration_hhmmss", "duration_text", "correlation_id"],
          "properties": {
            "intent": {
              "const": "timer.snooze"
            },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "duration_hhmmss": {
              "type": "string",
              "pattern": "^[0-9]{2,}:[0-9]{2}:[0-9]{2}$"
            },
            "duration_text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
