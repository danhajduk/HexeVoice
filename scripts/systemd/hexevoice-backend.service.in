[Unit]
Description=HexeVoice Backend
Wants=hexevoice-openwakeword.service hexevoice-stt.service hexevoice-piper-tts.service
After=hexevoice-openwakeword.service hexevoice-stt.service hexevoice-piper-tts.service

[Service]
WorkingDirectory=__ROOT_DIR__
LimitNOFILE=65536
ExecStart=/bin/bash -lc 'source "__ENV_FILE__"; cd "__ROOT_DIR__"; eval "$BACKEND_CMD"'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
