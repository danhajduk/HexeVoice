[Unit]
Description=HexeVoice Piper TTS Runtime

[Service]
Type=oneshot
WorkingDirectory=__ROOT_DIR__
RemainAfterExit=yes
TimeoutStartSec=300
TimeoutStopSec=60
ExecStart=/bin/bash -lc 'cd "__ROOT_DIR__"; ./scripts/piper-tts-control.sh ready'
ExecStop=/bin/bash -lc 'cd "__ROOT_DIR__"; ./scripts/piper-tts-control.sh stop'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
